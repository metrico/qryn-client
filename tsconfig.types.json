{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "outDir": "dist/types",
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js"]
}
